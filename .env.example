# Exemple de variables à configurer dans l'environnement de l'application.
# Ce fichier est un modèle : Django ne le charge pas automatiquement.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_ALLOWED_HOSTS=green-dev-africa-92575681.platform-systalink.com
DJANGO_BEHIND_PROXY=True
# Remplacer par l'URL de la base PostgreSQL persistante Systalink.
DATABASE_URL=postgresql://user:password@host:5432/green_dev_africa
# Utilisé uniquement en développement local si DATABASE_URL est absente.
# SQLITE_PATH=db.sqlite3
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=your-smtp-user
DJANGO_EMAIL_HOST_PASSWORD=your-smtp-password
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
